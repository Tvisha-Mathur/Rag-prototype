# Purpose: Documents required environment variables without private values. Used as the setup template for local and deployed environments.
FASTAPI_ENV=development
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=flexicore_incident_rag_prototype
# Add the Pages URL and custom frontend domain before exposing the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://YOUR_PROJECT.pages.dev,https://app.example.com
OLLAMA_BASE_URL=http://localhost:11434
HIPO_PROFILE_SHORT_CIRCUIT_ENABLED=false
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
AGENTIC_RETRIEVAL_ENABLED=true
AGENTIC_RETRIEVAL_MAX_QUERIES=3
EMBEDDING_LOCAL_FILES_ONLY=true
GEMINI_AGENT_ENABLED=true
GEMINI_AGENT_MODEL=gemini-3.7-flash
GEMINI_AGENT_TIMEOUT_SECONDS=45
GEMINI_AGENT_MAX_RETRIES=2
GEMINI_AGENT_COOLDOWN_SECONDS=60
GEMINI_AGENT_REDACT_PII=true
# Set this only in your private .env or deployment secret store.
GEMINI_API_KEY=
